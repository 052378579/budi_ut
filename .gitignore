#--------------------------------------------------------------------
# Operating Specific Junk Files
#--------------------------------------------------------------------

# OS X
.DS_Store
.AppleDouble
.LSOverride

# OS X Thumbnails
._*

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Linux
*~

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

#--------------------------------------------------------------------
# Environment & Sensitive System Configuration (STRICTLY PRIVATE)
#--------------------------------------------------------------------
# These should never be under version control as they pose severe security risks.
.env
.env.*
!.env.example
.vagrant
Vagrantfile

# Database Dumps, SQL Exports & Audit Reports
*.sql
*.sql.gz
*.sqlite
*.dump
audit_result.json

#--------------------------------------------------------------------
# AI Agents, Prompts & Internal Development SOPs (DO NOT SYNC TO GITHUB)
#--------------------------------------------------------------------
# Berkas & Direktori Tata Kelola Khusus Agen AI dan Server Lokal (DEV)
.agents/
vibe_coding.md
dok_git.txt

#--------------------------------------------------------------------
# Temporary, Runtime & Upload Files (HANYA FOLDER + index.html)
#--------------------------------------------------------------------
/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

/writable/PROFIL/*
!/writable/PROFIL/index.html

/writable/MK/*
!/writable/MK/index.html

# Log files
php_errors.log
*.log

#--------------------------------------------------------------------
# Backups, Services & Dependencies (HANYA FOLDER + index.html)
#--------------------------------------------------------------------
.bckup/
*.bckup
*.bak

# Python microservices (hanya folder + index.html)
/python_services/*
!/python_services/index.html

# Composer dependencies (hanya folder + index.html)
/vendor/*
!/vendor/index.html

#--------------------------------------------------------------------
# User Guide Temp Files
#--------------------------------------------------------------------
/user_guide_src/build/*
/user_guide_src/cilexer/build/*
/user_guide_src/cilexer/dist/*
/user_guide_src/cilexer/pycilexer.egg-info/*

#--------------------------------------------------------------------
# Test Files
#--------------------------------------------------------------------
/tests/coverage*
/phpunit
/results/
/phpunit.xml

#--------------------------------------------------------------------
# IDE / Development Files
#--------------------------------------------------------------------
# Modules Testing
_modules/*

# phpenv local config
.php-version

# Jetbrains editors (PHPStorm, etc)
.idea/
*.iml

# NetBeans
/nbproject/
/build/
/nbbuild/
/dist/
/nbdist/
/nbactions.xml
/nb-configuration.xml
/.nb-gradle/

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
